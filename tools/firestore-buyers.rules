// Правила для приложения покупателя. Вставить в Firebase console → Firestore → Rules ВНУТРЬ блока
// match /databases/{db}/documents { ... } рядом с остальными match (старый вариант этого блока заменить целиком).
// Покупатель видит только своё, дилер пишет только своим покупателям, пары и заявки решает администратор.

    // почта считается только подтверждённой (Google всегда подтверждает)
    function bEmail() { return request.auth != null && request.auth.token.email != null && request.auth.token.email_verified == true ? request.auth.token.email.lower() : ''; }
    function bAdmin() { return request.auth != null && bEmail() == '1mtulegenov@gmail.com'; }
    function bClient(cid) { return get(/databases/$(db)/documents/clients/$(cid)).data; }
    function bIsBuyer(c) { return (c.get('email', '') != '' && c.get('email', '') == bEmail()) || c.get('uid', '') == request.auth.uid; }

    match /clients/{cid} {
      allow read: if request.auth != null && (bAdmin() || bIsBuyer(resource.data) || resource.data.dealerEmail == bEmail());
      allow write: if bAdmin();
      match /lots/{lid} {
        allow read: if request.auth != null && (bAdmin() || bIsBuyer(bClient(cid)) || bClient(cid).dealerEmail == bEmail());
        allow create, update, delete: if request.auth != null && (bAdmin() || bClient(cid).dealerEmail == bEmail());
        // покупатель может только отметить «интересно / не подходит» и задать вопрос
        allow update: if request.auth != null && bIsBuyer(bClient(cid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reaction', 'reply', 'replyAt'])
          && request.resource.data.get('reaction', '') in ['', 'like', 'no']
          && (!('reply' in request.resource.data) || (request.resource.data.reply is string && request.resource.data.reply.size() <= 1000));
      }
    }
    // заявка на доступ: создаёт сам покупатель (статус pending), решает администратор
    function rqOk(d) { return d.keys().hasOnly(['uid', 'name', 'email', 'phone', 'note', 'status', 'at'])
      && d.get('name', '').size() <= 100 && d.get('phone', '').size() <= 40 && d.get('note', '').size() <= 500; }
    match /requests/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || bAdmin());
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.status == 'pending'
        && request.resource.data.get('email', '') == request.auth.token.get('email', '') && rqOk(request.resource.data);
      allow update: if bAdmin() || (request.auth != null && request.auth.uid == uid && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'note']) && rqOk(request.resource.data));
    }
    // сигнал «есть новая заявка» для пуша администратору: только время, без личных данных
    match /reqping/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['at']);
    }
    match /config/fees {
      allow read: if request.auth != null;
      allow write: if bAdmin();
    }
