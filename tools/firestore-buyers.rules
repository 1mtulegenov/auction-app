// Добавить в правила Firestore (Firebase console → Firestore → Rules) ВНУТРЬ блока
// match /databases/{database}/documents { ... } — рядом с остальными match. Остальное не трогать.
// Приложение покупателя: покупатель видит только своё, дилер пишет только своим покупателям, пары назначает администратор.

    function bEmail() { return request.auth.token.email.lower(); }
    function bAdmin() { return request.auth != null && bEmail() == '1mtulegenov@gmail.com'; }
    function bClient(cid) { return get(/databases/$(database)/documents/clients/$(cid)).data; }

    match /clients/{cid} {
      allow read: if request.auth != null && (bAdmin() || resource.data.email == bEmail() || resource.data.dealerEmail == bEmail());
      allow write: if bAdmin();
      match /lots/{lid} {
        allow read: if request.auth != null && (bAdmin() || bClient(cid).email == bEmail() || bClient(cid).dealerEmail == bEmail());
        allow create, update, delete: if request.auth != null && (bAdmin() || bClient(cid).dealerEmail == bEmail());
        // покупатель может только отметить «интересно / не подходит» и задать вопрос
        allow update: if request.auth != null && bClient(cid).email == bEmail()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reaction', 'reply', 'replyAt']);
      }
    }
    match /config/fees {
      allow read: if request.auth != null;
      allow write: if bAdmin();
    }
